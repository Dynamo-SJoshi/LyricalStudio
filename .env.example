# Copy this file to .env.local and fill in the values you need. Everything is optional:
# with no values set, the app runs fully (search through youtubei.js, no rate-limit sharing).
# Never commit .env.local (it is gitignored), and never put real keys in this file.

# ---------------------------------------------------------------------------
# Song search. All optional: with nothing set, search uses youtubei.js
# (an unofficial YouTube Music client), which is fine for running locally.

# Official YouTube Data API v3 key (server-only, never NEXT_PUBLIC_).
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
# Restrict the key to the YouTube Data API v3. The free quota is ~100 searches/day;
# results are cached to stretch it.
YOUTUBE_API_KEY=

# Set to false to never use youtubei.js (recommended for public deployments,
# together with YOUTUBE_API_KEY). Turns off the YouTube Music home feed,
# playlists and YouTube Music lyrics; "Up next" then comes from the artist's songs.
YOUTUBEI_ENABLED=

# ---------------------------------------------------------------------------
# Rate limiting of /api/* (per IP, per minute). Optional.
# Without Upstash each server instance counts on its own; with it, limits are shared.
# Free Redis at https://upstash.com → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to off to disable rate limiting (e.g. while load-testing locally).
RATE_LIMIT=
